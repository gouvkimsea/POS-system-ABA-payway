# ==============================================================================
# Development Environment Template (.env.example)
# Copy this file to .env for local development
# NEVER COMMIT REAL PRODUCTION SECRETS OR PASSWORDS TO SOURCE CONTROL
# ==============================================================================

# Application Environment
NODE_ENV=development

# Application Ports
API_PORT=4000
PORT=4000
WEB_PORT=3000
BRIDGE_PORT=9124

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pos_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pos_db?schema=public

# Redis Configuration (Optional in development, backend uses automatic in-memory fallback)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=debug

# Security & Authentication (JWT & Session Secrets)
# IMPORTANT: Generate high-entropy 64-character random strings in production
JWT_SECRET=dev_pos_jwt_secret_key_minimum_32_characters_long_12345
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=dev_pos_refresh_secret_key_minimum_32_characters_long_12345
REFRESH_TOKEN_EXPIRES_IN=7d

# Localization & Multi-Currency Defaults
DEFAULT_TIMEZONE=Asia/Phnom_Penh
DEFAULT_CURRENCY=USD
DEFAULT_EXCHANGE_RATE_KHR=4100
SUPPORTED_CURRENCIES=USD,KHR
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,km

# Frontend Client Public Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_DEFAULT_CURRENCY=USD
CORS_ORIGIN=http://localhost:3000

# Device Bridge & Hardware Network Configuration
DEVICE_BRIDGE_URL=http://localhost:9124
