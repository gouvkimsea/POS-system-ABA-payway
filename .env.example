# Application Environment
NODE_ENV=development

# Server Ports
BACKEND_PORT=4000
FRONTEND_PORT=3000

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pos_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pos_db?schema=public

# Redis Cache (Optional for dev fallback)
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=super_secret_pos_jwt_key_development_32_chars_long!
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=refresh_token_pos_jwt_key_development_32_chars_long!
REFRESH_TOKEN_EXPIRES_IN=7d

# Default Localization & Currency
DEFAULT_TIMEZONE=Asia/Phnom_Penh
DEFAULT_CURRENCY=USD
DEFAULT_EXCHANGE_RATE_KHR=4100
DEFAULT_TAX_RATE=0.10

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:4000/api
