{
  "name": "enterprise-pos-system",
  "version": "1.0.0",
  "private": true,
  "description": "Production-Ready Enterprise Point of Sale (POS) System",
  "scripts": {
    "dev:api": "pnpm --filter @pos/api dev",
    "dev:web": "pnpm --filter @pos/web dev",
    "dev": "pnpm --parallel --filter @pos/api --filter @pos/web dev",
    "dev:bridge": "pnpm --filter @pos/bridge dev",
    "bridge:start": "pnpm --filter @pos/bridge start",
    "build:packages": "pnpm --filter @pos/types build && pnpm --filter @pos/config build && pnpm --filter @pos/validation build && pnpm --filter @pos/ui build",
    "build": "pnpm run build:packages && pnpm --filter @pos/bridge build && pnpm --filter @pos/api build && pnpm --filter @pos/web build",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "eslint . --ext .ts,.tsx,.js",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "db:start": "node scripts/db-runner.js start",
    "db:status": "node scripts/db-runner.js status",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test:connections": "tsx scripts/test-connections.ts",
    "test:auth": "tsx scripts/test-auth-integration.ts",
    "test:pos": "tsx scripts/test-pos-integration.ts",
    "test:inventory": "tsx scripts/test-inventory-integration.ts",
    "test:transactions": "tsx scripts/test-transaction-engine.ts",
    "test:hardware": "tsx scripts/test-hardware-integration.ts"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^3.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.7",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^8.57.0",
    "ioredis": "^5.4.2",
    "prettier": "^3.5.0",
    "prisma": "^5.22.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
