# ==============================================================================
# Production Environment Template (.env.production.example)
# Use this template for production container deployments
# ==============================================================================

# Application Environment
NODE_ENV=production

# Application Ports
API_PORT=4000
PORT=4000
WEB_PORT=3000

# PostgreSQL Database Configuration
POSTGRES_USER=pos_prod_admin
POSTGRES_PASSWORD=replace_with_strong_production_password_min_32_chars
POSTGRES_DB=pos_production_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pos_prod_admin:replace_with_strong_production_password_min_32_chars@postgres:5432/pos_production_db?schema=public&sslmode=prefer

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_strong_redis_password
REDIS_URL=redis://:replace_with_strong_redis_password@redis:6379

# Logging
LOG_LEVEL=info

# Security & Authentication
JWT_SECRET=replace_with_production_jwt_secret_entropy_64_bytes_hex
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=replace_with_production_refresh_token_secret_entropy_64_bytes_hex
REFRESH_TOKEN_EXPIRES_IN=7d

# Localization & Multi-Currency Defaults
DEFAULT_TIMEZONE=Asia/Phnom_Penh
DEFAULT_CURRENCY=USD
DEFAULT_EXCHANGE_RATE_KHR=4100
SUPPORTED_CURRENCIES=USD,KHR
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,km

# Client URLs & Security
NEXT_PUBLIC_API_URL=https://api.pos.yourdomain.com/api
NEXT_PUBLIC_DEFAULT_CURRENCY=USD
CORS_ORIGIN=https://pos.yourdomain.com
